[Unit]
Description=Copy boot logs to the FAT partition when BOOT has a debug file
After=local-fs.target

[Service]
Type=simple
# Our initramfs installs steamos-arm-bootdebug.service itself; this one is for
# kernels with their own initramfs. Runs only with a debug/debug.txt file on
# BOOT, or exact steamos.debug=1, steamos.screenlog=1, steamos.logupload=1.
# Upload additionally requires exact steamos.session=plasma in the collector.
ExecCondition=/bin/sh -c '[ ! -e /usr/lib/systemd/system/steamos-arm-bootdebug.service ] || exit 1; mountpoint -q /boot || mount /boot 2>/dev/null; [ -e /boot/debug ] || [ -e /boot/debug.txt ] || grep -qE "(^|[[:space:]])steamos[.](debug|screenlog|logupload)=1([[:space:]]|$)" /proc/cmdline'
ExecStart=/usr/lib/steamos-arm/bootdebug
