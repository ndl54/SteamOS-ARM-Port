#!/bin/bash
# Official steamosctl wrapper. Prepare Wayland env before desktop mode so
# Plasma does not inherit Game Mode QT_QPA_PLATFORM=xcb.
set -e

session="${1:-gamescope}"
return_shortcut=0
if [[ "$session" == --return-to-game-mode ]]; then
  session=gamescope
  return_shortcut=1
fi

# Lenovo Legion Y700 Gen 4: handing the panel from gamescope to KWin (or
# back) in one boot jams its display controller and the screen stays on the
# last frame. Starting either session at boot works, so switch by restarting
# into it; on a normal boot the session stays the default until switched back.
if tr '\0' '\n' </sys/firmware/devicetree/base/compatible 2>/dev/null | grep -qxE 'lenovo,(elden|baldur)'; then
  case "$session" in
    plasma|plasma-persistent|gamescope) ;;
    *) echo >&2 "!! Unrecognized session '$session'"; exit 1 ;;
  esac
  # The initramfs deliberately gives this debug boot override precedence.
  # Rebooting the same entry cannot return to Game Mode while it is present.
  if [[ "$session" == gamescope ]] && grep -qE '(^|[[:space:]])steamos[.]session=plasma([[:space:]]|$)' /proc/cmdline; then
    echo >&2 '!! Boot without steamos.session=plasma to return to Game Mode.'
    exit 1
  fi
  # apply-hotfix binds its tmpfs snapshot over /etc. The manager would report
  # success but its SDDM selection would disappear on reboot. Do not write
  # around the overlay; use a normal boot to change persistent preferences.
  if awk '$1 == "hotfix" && $2 == "/etc" && $3 == "tmpfs" { found=1 } END { exit !found }' /proc/mounts; then
    echo >&2 '!! Session selection is temporary with an /etc hotfix; boot with steamos.hotfix=0 first.'
    exit 1
  fi
  case "$session" in
    plasma|plasma-persistent)
      # sm8550-startplasma prepares the environment on the next boot. Leave
      # the current session alone if saving the selection or reboot fails.
      steamosctl set-default-desktop-session plasma.desktop
      steamosctl set-default-login-mode desktop
      ;;
    gamescope)
      steamosctl set-default-login-mode game
      ;;
  esac
  exec systemctl reboot
fi

# Keep the existing shortcut's live-switch/fallback behavior on other boards.
# On Elden we have already exited, including on failure: never fall back to
# a live compositor handover or logout there.
if [[ "$return_shortcut" == 1 ]]; then
  exec bash -c 'steamosctl switch-to-game-mode || steamos-session-select gamescope || qdbus org.kde.Shutdown /Shutdown org.kde.Shutdown.logout'
fi

case "$session" in
  plasma-persistent)
    /usr/lib/steamos/sm8550-prepare-plasma
    steamosctl set-default-login-mode desktop
    steamosctl set-default-desktop-session plasma.desktop
    steamosctl switch-to-desktop-mode
    ;;
  plasma)
    /usr/lib/steamos/sm8550-prepare-plasma
    steamosctl set-default-desktop-session plasma.desktop
    steamosctl switch-to-desktop-mode
    ;;
  gamescope)
    steamosctl set-default-login-mode game
    steamosctl switch-to-game-mode
    ;;
  *)
    echo >&2 "!! Unrecognized session '$session'"
    exit 1
    ;;
esac
