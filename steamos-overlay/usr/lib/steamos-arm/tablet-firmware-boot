#!/bin/bash
# Boot step for tablets whose firmware comes out of their own Android
# (steamos-arm-tablet-firmware.service). Copies what is missing, then gives
# the DSPs, Wi-Fi and Bluetooth another go if they came up without it.
set -u
model=""
tr '\0' '\n' </sys/firmware/devicetree/base/compatible 2>/dev/null | grep -qx 'lenovo,elden' && model=elden
[[ -n "$model" ]] || exit 0
manifest=/usr/share/steamos-arm/tablets/${model}-firmware.json
dest=/var/lib/steamos-arm/firmware/${model}
[[ -f "$manifest" ]] || exit 0
# Remember a fresh firmware destination across partial extraction/retries.
# Existing installations do not acquire an unsolicited reboot on an update.
pending="$dest/.first-boot-restart-pending"
restarted="$dest/.first-boot-restarted"
if [[ ! -e "$restarted" && ! -e "$pending" ]] && \
   [[ ! -d "$dest" || -z "$(find "$dest" -type f -print -quit)" ]]; then
  mkdir -p "$dest" && : >"$pending" || exit 1
fi
changed=$(mktemp) || exit 1
trap 'rm -f "$changed"' EXIT
/usr/lib/steamos-arm/tablet-firmware "$manifest" "$dest" --also /usr/lib/firmware \
  --changed-file "$changed" || exit 1
# Replacing a stale fallback changes bytes without changing the file count.
# A failed reboot request must be retryable even if the next extraction is unchanged.
if [[ -e "$pending" && ! -e "$restarted" && -s "$dest/qcom/sm8750/adsp.mdt" && -s "$dest/qcom/sm8750/adsp_dtb.mdt" ]]; then
  : >"$restarted" || exit 1
  sync
  echo "tablet-firmware: first audio firmware copied, requesting one reboot"
  if systemctl --no-block reboot; then
    rm -f "$pending"
    exit 0
  fi
  rm -f "$restarted"
  echo "tablet-firmware: reboot request failed; will retry next boot" >&2
  exit 1
fi
[[ -s "$changed" ]] || exit 0
# Remote processors that failed to start for want of firmware.
for rp in /sys/class/remoteproc/remoteproc*; do
  [[ "$(cat "$rp/state" 2>/dev/null)" == offline ]] && echo start >"$rp/state" 2>/dev/null
done
# Wi-Fi and Bluetooth load their firmware when the driver binds. On the first
# boot the Wi-Fi card probes before the copy and is left unbound; reloading
# the module didn't bring it back, so remove the card and rescan the bus,
# which gives the driver another probe. Interface names need not be wlan0.
wifi_present() {
  local net
  for net in /sys/class/net/*; do
    [[ -e "$net/phy80211" ]] && return 0
  done
  return 1
}
wait_for_wifi() {
  local attempt
  for ((attempt = 0; attempt < 30; attempt++)); do
    wifi_present && return 0
    sleep 0.5
  done
  wifi_present
}
if ! wifi_present; then
  removed=0
  for d in /sys/bus/pci/devices/*; do
    [[ "$(cat "$d/vendor" 2>/dev/null)" == 0x17cb && "$(cat "$d/class" 2>/dev/null)" == 0x0280* && ! -e "$d/driver" ]] || continue
    echo "tablet-firmware: Wi-Fi ${d##*/} unbound, rescanning"
    if echo 1 >"$d/remove"; then
      removed=1
    else
      echo "tablet-firmware: Wi-Fi ${d##*/} removal failed" >&2
    fi
  done
  # Do not rescan unrelated PCI devices when no eligible card was removed.
  if (( removed )); then
    if echo 1 >/sys/bus/pci/rescan; then
      wait_for_wifi || true
    else
      echo "tablet-firmware: PCI rescan failed" >&2
    fi
  fi
  if ! wifi_present; then
    modprobe -r ath12k_wifi7 ath12k 2>/dev/null; modprobe ath12k_wifi7 2>/dev/null || modprobe ath12k 2>/dev/null
    wait_for_wifi || true
  fi
  wifi_present && echo "tablet-firmware: Wi-Fi interface present" || echo "tablet-firmware: Wi-Fi still missing"
fi
# This unit is ordered before bluetooth: waiting for that job would wait on us.
systemctl --no-block try-restart bluetooth.service 2>/dev/null
exit 0
