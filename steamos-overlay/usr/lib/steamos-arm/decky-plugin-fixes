#!/usr/bin/env python3
"""Small fixes to Decky plugins from the store that break on the Steam client
we ship, applied where they're installed (~/homebrew/plugins) and only while
the broken code is still there: once a plugin ships its own fix, nothing
matches and nothing changes. Decky is restarted when something was fixed,
since it has already loaded the old code.

- SteamGridDB 1.7.1: the Steam beta changed its footer button glyph, so the
  plugin's lookup found nothing and its panel crashed on open. Upstream fixed
  the lookup (SteamGridDB/decky-steamgriddb#175, not released yet); this is
  the same check.

It also installs the plugins the image bundles in /usr/share/steamos-arm/
decky-plugins, which updates can't put in the home folder themselves.
This supports older updaters that carry only two home plugin folders;
upstream targets 1.4 for this bundled-plugin delivery. Each bundled version
is offered once: a plugin removed in Decky stays removed until a newer one
comes with an update. Existing unmanaged or locally modified copies are kept.
"""
import glob
import hashlib
import tempfile
from pathlib import Path
import json
import os
import shutil
import subprocess

PLUGINS = "/home/steamos/homebrew/plugins"
BUNDLED = "/usr/share/steamos-arm/decky-plugins"
STATE = "/var/lib/steamos-arm/bundled-plugins.json"

FIXES = [
    ("SteamGridDB footer glyph", "*/dist/index.js",
     "const FooterGlyph = DFL.findModuleExport((e) => e?.toString && e.toString().includes('.Knockout') "
     "&& e.toString().includes('.additionalClassName'));",
     "const FooterGlyph = DFL.findModuleExport((e) => { if (typeof e !== 'function') return false; "
     "const s = e.toString(); return s.includes('.additionalClassName') && (s.includes('.Knockout') || "
     "(s.includes('bIsKnockout') && s.includes('#ControllerButton_A'))); });"),
]


def version(folder):
    try:
        with open(os.path.join(folder, "package.json"), encoding="utf-8") as fh:
            data = json.load(fh)
        value = data.get("version") if isinstance(data, dict) else None
        return value if isinstance(value, str) and value.strip() else ""
    except (OSError, ValueError):
        return ""


def tree_digest(folder):
    """Fingerprint ordinary bundle files; never follow links in a user tree."""
    root = Path(folder)
    if root.is_symlink() or not root.is_dir():
        return None
    digest = hashlib.sha256()
    for path in sorted(root.rglob("*")):
        if "__pycache__" in path.relative_to(root).parts:
            continue  # Generated interpreter caches do not make a plugin custom.
        if path.is_symlink():
            return None
        rel = path.relative_to(root).as_posix()
        digest.update(rel.encode() + b"\0")
        if path.is_file():
            digest.update(b"file\0" + path.read_bytes())
            digest.update(str(path.stat().st_mode & 0o777).encode())
        elif path.is_dir():
            digest.update(b"dir\0")
        else:
            return None
    return digest.hexdigest()


def save_state(done):
    target = Path(STATE)
    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8",
                                         dir=target.parent, delete=False) as fh:
            temporary = Path(fh.name)
            json.dump(done, fh)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(temporary, target)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def install_bundled():
    try:
        with open(STATE, encoding="utf-8") as fh:
            done = json.load(fh)
    except FileNotFoundError:
        done = {}
    # Corrupt history must not resurrect removed plugins or overwrite a user copy.
    if not isinstance(done, dict):
        raise ValueError("Invalid bundled-plugin history; preserving installed plugins")
    installed = []
    for src in sorted(glob.glob(f"{BUNDLED}/*/")):
        name = os.path.basename(src.rstrip("/"))
        want = version(src)
        source_hash = tree_digest(src.rstrip("/"))
        if not want or source_hash is None:
            raise ValueError(f"Invalid bundled plugin: {name}")
        if not all((Path(src) / part).is_file() for part in ("plugin.json", "main.py", "dist/index.js")):
            raise ValueError(f"Incomplete bundled plugin: {name}")
        dst = Path(PLUGINS) / name
        previous = done.get(name)
        previous_version = previous.get("version") if isinstance(previous, dict) else previous
        if previous_version == want:
            continue  # Includes deliberate removal after this version was offered.
        exists = dst.exists() or dst.is_symlink()
        current_hash = tree_digest(dst) if exists else None
        if exists and version(dst) == want and current_hash == source_hash:
            done[name] = {"version": want, "digest": source_hash}
            save_state(done)
            continue
        if exists and (not isinstance(previous, dict) or not current_hash
                       or current_hash != previous.get("digest")):
            print(f"decky-plugin-fixes: preserving custom/unmanaged plugin {name}")
            continue
        # Unique staging path; keep the previous directory until publication
        # succeeds. Copy/chown/rename failure leaves it intact and retryable.
        work = Path(tempfile.mkdtemp(prefix=f".{name}.", dir=PLUGINS))
        payload, backup = work / "payload", work / "previous"
        committed = False
        published = False
        try:
            shutil.copytree(src, payload)
            subprocess.run(["chown", "-R", "1000:1000", str(payload)], check=True)
            if exists:
                os.replace(dst, backup)
            try:
                os.replace(payload, dst)
                published = True
                done[name] = {"version": want, "digest": source_hash}
                save_state(done)
                committed = True
            except BaseException:
                if published:
                    shutil.rmtree(dst)
                if exists:
                    os.replace(backup, dst)
                raise
        finally:
            # Retain recovery data if restoration itself fails.
            if committed or not backup.exists():
                shutil.rmtree(work)
        installed.append(f"{name} {want}")
    return installed


def main() -> int:
    fixed = []
    failed = False
    if os.path.isdir(PLUGINS):
        try:
            fixed += [f"installed {p}" for p in install_bundled()]
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            print(f"decky-plugin-fixes: bundle installation failed: {error}")
            failed = True
    for name, pattern, old, new in FIXES:
        for path in glob.glob(f"{PLUGINS}/{pattern}"):
            try:
                with open(path, encoding="utf-8") as fh:
                    text = fh.read()
            except (OSError, UnicodeDecodeError):
                continue
            if old not in text:
                continue
            with open(path + ".fix", "w", encoding="utf-8") as fh:
                fh.write(text.replace(old, new))
            subprocess.run(["chown", "--reference", path, path + ".fix"], check=False)
            subprocess.run(["chmod", "--reference", path, path + ".fix"], check=False)
            os.replace(path + ".fix", path)
            fixed.append(f"{name} ({path})")
    for f in fixed:
        print(f"decky-plugin-fixes: {f}")
    if fixed:
        # --no-block: this unit runs before Decky, so waiting for its restart
        # here would wait on ourselves
        subprocess.run(["systemctl", "--no-block", "try-restart", "plugin_loader.service"], check=False)
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
