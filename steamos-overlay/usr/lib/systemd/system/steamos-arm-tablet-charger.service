[Unit]
Description=Stay dark and charge when the tablet was started by its charger (Lenovo tablets)
ConditionFirmware=|device-tree-compatible(lenovo,tb321fu)
ConditionFirmware=|device-tree-compatible(lenovo,elden)
After=systemd-udev-settle.service local-fs.target
Before=display-manager.service konkrd.service odin3d.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=infinity
# Keep logind from also acting on the press used by the charging UI.
ExecStart=/usr/bin/systemd-inhibit --what=handle-power-key --who=tablet-charger --why="Charging screen handles Power" /usr/lib/steamos-arm/tablet-charger-hold

[Install]
WantedBy=multi-user.target
