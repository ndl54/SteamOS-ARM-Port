From: lavachemist <48248311+lavachemist@users.noreply.github.com>
Subject: [PATCH] drm/msm/dsi: phy: unprepare the iface clock across system sleep

The DSI PHY manages its "iface" clock (disp_cc_mdss_ahb_clk) with pm_clk,
which prepares it at probe and only disables it on runtime suspend. A
prepared clock under the XO keeps the XO vote, so the SM8550 handhelds never
reached XO shutdown in system sleep even with the display off.

When the PHY is already runtime-suspended, drop the prepare late in system
suspend and take it back early in resume. Per PHY instance, so it covers
both screens of the AYN Thor. Tested on the Retroid Pocket Nova (one DSI)
with a test module doing the same; the Thor's second screen is untested.
---

Integration review: balance lifecycle and preserve error handling; see report 090.

Own the iface prepare/enable counts explicitly instead of changing pm_clk
state through a second handle. Preserve the suspended-only system-sleep drop,
retry prepare failures before runtime enable, and balance devres teardown.

--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
@@ -3,9 +3,9 @@
  * Copyright (c) 2015, The Linux Foundation. All rights reserved.
  */
 
+#include <linux/clk.h>
 #include <linux/clk-provider.h>
 #include <linux/platform_device.h>
-#include <linux/pm_clock.h>
 #include <linux/pm_runtime.h>
 #include <dt-bindings/phy/phy.h>
 
@@ -610,6 +610,17 @@
 	return -EINVAL;
 }
 
+/* Own the prepare count: do not borrow pm_clk's reference with another handle. */
+static void dsi_phy_iface_cleanup(void *data)
+{
+	struct msm_dsi_phy *phy = data;
+
+	if (phy->iface_enabled)
+		clk_disable(phy->iface_vote);
+	if (phy->iface_prepared)
+		clk_unprepare(phy->iface_vote);
+}
+
 static int dsi_phy_driver_probe(struct platform_device *pdev)
 {
 	struct msm_dsi_phy *phy;
@@ -683,17 +694,23 @@
 
 	platform_set_drvdata(pdev, phy);
 
+	phy->iface_vote = devm_clk_get(dev, "iface");
+	if (IS_ERR(phy->iface_vote))
+		return dev_err_probe(dev, PTR_ERR(phy->iface_vote), "Unable to get iface clk\n");
+	phy->iface_prepare_enables = clk_is_enabled_when_prepared(phy->iface_vote);
+	if (!phy->iface_prepare_enables) {
+		ret = clk_prepare(phy->iface_vote);
+		if (ret)
+			return ret;
+		phy->iface_prepared = true;
+	}
+	ret = devm_add_action_or_reset(dev, dsi_phy_iface_cleanup, phy);
+	if (ret)
+		return ret;
+	/* Disable/drain runtime PM before releasing our clock vote on teardown. */
 	ret = devm_pm_runtime_enable(dev);
 	if (ret)
 		return ret;
-
-	ret = devm_pm_clk_create(dev);
-	if (ret)
-		return ret;
-
-	ret = pm_clk_add(dev, "iface");
-	if (ret < 0)
-		return dev_err_probe(dev, ret, "Unable to get iface clk\n");
 
 	if (phy->cfg->ops.pll_init) {
 		ret = phy->cfg->ops.pll_init(phy);
@@ -711,8 +728,76 @@
 	return 0;
 }
 
+static int __maybe_unused dsi_phy_prepare_iface(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+	int ret;
+
+	if (phy->iface_prepared)
+		return 0;
+	ret = clk_prepare(phy->iface_vote);
+	if (!ret) {
+		phy->iface_prepared = true;
+		phy->iface_sleep_dropped = false;
+	}
+	return ret;
+}
+
+static int __maybe_unused dsi_phy_runtime_suspend(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+
+	clk_disable(phy->iface_vote);
+	phy->iface_enabled = false;
+	/* Preserve pm_clk behavior for clocks controlled by prepare/unprepare. */
+	if (phy->iface_prepare_enables) {
+		clk_unprepare(phy->iface_vote);
+		phy->iface_prepared = false;
+	}
+	return 0;
+}
+
+static int __maybe_unused dsi_phy_runtime_resume(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+	int ret;
+
+	/* Retry a failed system-resume prepare before enabling the clock. */
+	ret = dsi_phy_prepare_iface(dev);
+	if (ret)
+		return ret;
+	ret = clk_enable(phy->iface_vote);
+	if (!ret) {
+		phy->iface_enabled = true;
+	} else if (phy->iface_prepare_enables) {
+		clk_unprepare(phy->iface_vote);
+		phy->iface_prepared = false;
+	}
+	return ret;
+}
+
+static int __maybe_unused dsi_phy_suspend_noirq(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+
+	if (pm_runtime_status_suspended(dev) && phy->iface_prepared) {
+		clk_unprepare(phy->iface_vote);
+		phy->iface_prepared = false;
+		phy->iface_sleep_dropped = true;
+	}
+	return 0;
+}
+
+static int __maybe_unused dsi_phy_resume_noirq(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+
+	return phy->iface_sleep_dropped ? dsi_phy_prepare_iface(dev) : 0;
+}
+
 static const struct dev_pm_ops dsi_phy_pm_ops = {
-	SET_RUNTIME_PM_OPS(pm_clk_suspend, pm_clk_resume, NULL)
+	SET_RUNTIME_PM_OPS(dsi_phy_runtime_suspend, dsi_phy_runtime_resume, NULL)
+	NOIRQ_SYSTEM_SLEEP_PM_OPS(dsi_phy_suspend_noirq, dsi_phy_resume_noirq)
 };
 
 static struct platform_driver dsi_phy_platform_driver = {
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
@@ -122,6 +122,12 @@
 	struct clk_hw_onecell_data *provided_clocks;
 
 	bool state_saved;
+
+	struct clk *iface_vote;
+	bool iface_prepared;
+	bool iface_enabled;
+	bool iface_prepare_enables;
+	bool iface_sleep_dropped;
 };
 
 /*
