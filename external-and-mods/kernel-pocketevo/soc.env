# Pocket EVO-only kernel; never use this image for another SM8550 board.
SM8550_RECIPE=7.2
SM8550_KERNEL=rocknix
source "$(dirname "${BASH_SOURCE[0]}")/../kernel-sm8550/soc.env"
KNAME=pocketevo
PATCH_FUZZ=0
PATCH_OVERRIDE_DIR="$(dirname "${BASH_SOURCE[0]}")/patches/rebased"
PORT_DIRS="kernel-sm8550 kernel-pocketevo"
DTBS=qcs8550-ayaneo-pocketevo
if [[ -n ${DTBS_OVERRIDE:-} && $DTBS_OVERRIDE != "$DTBS" ]]; then
  echo "Pocket EVO recipe only accepts its own DTB" >&2
  exit 2
fi
PATCH_SKIP="$PATCH_SKIP 0033-scsi-ufs-qcom-keep-lane-clock-enables-balanced.patch 0034-tty-serial-qcom-geni-release-cx-votes-across-system-suspend.patch 0053-drm-msm-a6xx-preserve-hfi-response-bits.patch 0054-drm-msm-a6xx-bound-fault-coredump-waits.patch 0055-drm-msm-a6xx-mask-hfi-before-gmu-boot.patch 0056-usb-xhci-pci-renesas-restore-firmware-on-resume.patch"

# Combined upstream fixes overlap 9053-9055 and 9066 below. Keep one copy.
PATCH_SKIP="$PATCH_SKIP 0054-drm-msm-a6xx-stop-gpu-wake-ups-losing-gmu-replies.patch 0055-drm-msm-dpu-real-vblank-timestamps-on-command-mode-panels.patch"
