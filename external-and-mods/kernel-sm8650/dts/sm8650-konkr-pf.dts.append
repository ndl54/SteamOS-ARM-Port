
/* --- SteamOS-ARM-SM8650 additions --------------------------------------- */

/ {
	chassis-type = "handheld";
};

/*
 * Controller MCU UART (geni SE5 @894000). konkr_sysbtn binds here when the
 * module is loaded (it is blacklisted by default — see konkr-mcu).
 */
&uart13 {
	mcu {
		compatible = "konkr,pocket-fit-mcu";
	};
};

/*
 * Pocket FIT's 903 MHz OPP: match the TURBO corner and ACD value in the
 * pinned ROCKNIX sm8650-ayaneo-common.dtsi. That shared table also contains
 * 1.0 and 1.05 GHz OPPs, so this is not a maximum-frequency cap. The ACD
 * property was already inherited; spelling it out here preserves it.
 * Bus vote stays equal to the 834 MHz step. Factory voltage, stability and
 * power/temperature savings have not been independently verified on hardware.
 */
&gpu_opp_table {
	opp-903000000 {
		opp-hz = /bits/ 64 <903000000>;
		opp-level = <RPMH_REGULATOR_LEVEL_TURBO>;
		opp-peak-kBps = <14398437>;
		qcom,opp-acd-level = <0x882a5ffd>;
	};
};
