From: lavachemist <48248311+lavachemist@users.noreply.github.com>
Subject: [PATCH] ASoC: wsa884x: restart the PA when it fails to turn on

On the KONKR Pocket FIT the speakers now and then went silent and stayed
silent until a reboot. The PCM kept running and both amplifiers stayed
attached and runtime-active, but their PA state machine sat in an error
state (PA_FSM_STA0 0x20, PA_FSM_ERR_COND0 0x40; 0x2f and 0x00 when
playing). Unbinding and rebinding the driver brought the sound back.

Logging every fault showed that both amplifiers fail together, always
right at stream start (found at the first check after unmute, never
mid-stream), with INTR_STATUS1 bit 1 set: PA_ON_ERR in Qualcomm's
downstream driver, whose handler for it disables the PA and pulses
PA_FSM_CTL0 bit 4. Upstream has no SoundWire interrupt support for this
codec, so nothing ever cleared the error; it happened about once every
one to two minutes of normal use.

While the stream is unmuted, check PA_FSM_ERR_COND0/1 30 ms and 150 ms
after unmute and then once a second. For the observed PA_ON_ERR signature (ERR_COND0 bit 6 alone,
ERR_COND1 zero and INTR_STATUS1 bit 1), log it (time
since unmute, state, error and interrupt status, which is then cleared)
and restart the PA the downstream way after checked writes: GLOBAL_PA_EN off, pulse
PA_FSM_CTL0 bit 4, GLOBAL_PA_EN on. The check only reads while the
device is already runtime-active. Other fault signatures are not reset.
Serialize recovery with mute; drain work before stream teardown and before
regmap/regulator devres cleanup. Use a freezable queue across system sleep.

Developed with Claude Opus 5.5 (Anthropic) via Claude Code.
---

-rw-r--r-- 1 root root 110104 01:01 sound/soc/codecs/wsa884x.o

Integration review: balance lifecycle and preserve error handling; see report 090.

--- a/sound/soc/codecs/wsa884x.c
+++ b/sound/soc/codecs/wsa884x.c
@@ -22,6 +22,8 @@
 #include <linux/soundwire/sdw.h>
 #include <linux/soundwire/sdw_registers.h>
 #include <linux/soundwire/sdw_type.h>
+#include <linux/ktime.h>
+#include <linux/workqueue.h>
 #include <sound/pcm.h>
 #include <sound/pcm_params.h>
 #include <sound/soc-dapm.h>
@@ -748,7 +750,19 @@
 	struct mutex sp_lock;
 	unsigned int temperature;
 	bool pa_on;
-};
+	/* PA fault recovery while the stream is unmuted */
+	struct delayed_work pa_check_work;
+	struct mutex pa_lock;
+	bool pa_unmuted;
+	unsigned int pa_checks;
+	ktime_t unmute_time;
+};
+
+#define WSA884X_PA_FSM_CTL0_ERR_CLR_MASK	0x10
+/* Early checks catch a PA that failed to start; then keep watching. */
+#define WSA884X_PA_CHECK_FIRST_MS		30
+#define WSA884X_PA_CHECK_SECOND_MS		120
+#define WSA884X_PA_CHECK_MS			1000
 
 enum {
 	COMP_OFFSET0,
@@ -1694,6 +1708,8 @@
 				      curr_limit);
 }
 
+static void wsa884x_cancel_pa_check(void *data);
+
 static int wsa884x_spkr_event(struct snd_soc_dapm_widget *w,
 			      struct snd_kcontrol *kcontrol, int event)
 {
@@ -1714,6 +1730,7 @@
 
 		break;
 	case SND_SOC_DAPM_PRE_PMD:
+		wsa884x_cancel_pa_check(wsa884x);
 		snd_soc_component_write_field(component, WSA884X_PDM_WD_CTL,
 					      WSA884X_PDM_WD_CTL_PDM_WD_EN_MASK,
 					      0x0);
@@ -1797,9 +1814,95 @@
 {
 	struct wsa884x_priv *wsa884x = dev_get_drvdata(dai->dev);
 
+	wsa884x_cancel_pa_check(wsa884x);
 	sdw_stream_remove_slave(wsa884x->slave, wsa884x->sruntime);
 
 	return 0;
+}
+
+/*
+ * The PA state machine latches faults (under-voltage, PDM watchdog, ...) and
+ * then keeps the PA off: the stream runs but the speaker is silent until the
+ * amplifier is reset. Nothing upstream reports or clears these (no SoundWire
+ * interrupt support), so poll the error flags while unmuted and restart the
+ * PA the way Qualcomm's downstream driver does in its PA-on-error handler.
+ */
+static void wsa884x_pa_check_work(struct work_struct *work)
+{
+	struct wsa884x_priv *wsa884x = container_of(to_delayed_work(work),
+						    struct wsa884x_priv,
+						    pa_check_work);
+	unsigned int err0, err1, sta0 = 0, intr0 = 0, intr1 = 0;
+	int ret;
+
+	guard(mutex)(&wsa884x->pa_lock);
+
+	if (!wsa884x->pa_unmuted)
+		return;
+
+	if (pm_runtime_get_if_active(wsa884x->dev) > 0) {
+		if (!regmap_read(wsa884x->regmap, WSA884X_PA_FSM_ERR_COND0, &err0) &&
+		    !regmap_read(wsa884x->regmap, WSA884X_PA_FSM_ERR_COND1, &err1) &&
+		    err0 == BIT(6) && !err1 &&
+		    !regmap_read(wsa884x->regmap, WSA884X_INTR_STATUS1, &intr1) &&
+		    (intr1 & BIT(1))) {
+			regmap_read(wsa884x->regmap, WSA884X_PA_FSM_STA0, &sta0);
+			regmap_read(wsa884x->regmap, WSA884X_INTR_STATUS0, &intr0);
+			regmap_read(wsa884x->regmap, WSA884X_INTR_STATUS1, &intr1);
+			dev_warn_ratelimited(wsa884x->dev,
+					     "PA fault %lld ms after unmute (state %#x, err %#x/%#x, intr %#x/%#x), restarting PA\n",
+					     ktime_ms_delta(ktime_get(), wsa884x->unmute_time),
+					     sta0, err0, err1, intr0, intr1);
+			/* Only recover PA_ON_ERR, never blindly restart other protection faults. */
+			ret = regmap_update_bits(wsa884x->regmap, WSA884X_PA_FSM_EN,
+						 WSA884X_PA_FSM_EN_GLOBAL_PA_EN_MASK, 0);
+			if (!ret)
+				ret = regmap_update_bits(wsa884x->regmap, WSA884X_PA_FSM_CTL0,
+							 WSA884X_PA_FSM_CTL0_ERR_CLR_MASK, 0);
+			if (!ret)
+				ret = regmap_update_bits(wsa884x->regmap, WSA884X_PA_FSM_CTL0,
+							 WSA884X_PA_FSM_CTL0_ERR_CLR_MASK,
+							 WSA884X_PA_FSM_CTL0_ERR_CLR_MASK);
+			if (!ret)
+				ret = regmap_update_bits(wsa884x->regmap, WSA884X_PA_FSM_CTL0,
+							 WSA884X_PA_FSM_CTL0_ERR_CLR_MASK, 0);
+			if (!ret)
+				ret = regmap_write(wsa884x->regmap, WSA884X_INTR_CLEAR1, BIT(1));
+			if (!ret)
+				ret = regmap_write(wsa884x->regmap, WSA884X_INTR_CLEAR1, 0);
+			if (!ret)
+				ret = regmap_update_bits(wsa884x->regmap, WSA884X_PA_FSM_EN,
+							 WSA884X_PA_FSM_EN_GLOBAL_PA_EN_MASK,
+							 WSA884X_PA_FSM_EN_GLOBAL_PA_EN_MASK);
+			if (ret)
+				dev_warn_ratelimited(wsa884x->dev, "PA recovery failed: %d\n", ret);
+		}
+		pm_runtime_put_autosuspend(wsa884x->dev);
+	}
+
+	if (wsa884x->pa_unmuted)
+		queue_delayed_work(system_freezable_wq, &wsa884x->pa_check_work,
+				      msecs_to_jiffies(wsa884x->pa_checks++ ?
+						       WSA884X_PA_CHECK_MS :
+						       WSA884X_PA_CHECK_SECOND_MS));
+}
+
+static void wsa884x_cancel_pa_check(void *data)
+{
+	struct wsa884x_priv *wsa884x = data;
+
+	mutex_lock(&wsa884x->pa_lock);
+	wsa884x->pa_unmuted = false;
+	mutex_unlock(&wsa884x->pa_lock);
+	cancel_delayed_work_sync(&wsa884x->pa_check_work);
+}
+
+static void wsa884x_pa_cleanup(void *data)
+{
+	struct wsa884x_priv *wsa884x = data;
+
+	wsa884x_cancel_pa_check(wsa884x);
+	pm_runtime_disable(wsa884x->dev);
 }
 
 static int wsa884x_mute_stream(struct snd_soc_dai *dai, int mute, int stream)
@@ -1807,7 +1910,11 @@
 	struct snd_soc_component *component = dai->component;
 	struct wsa884x_priv *wsa884x = snd_soc_component_get_drvdata(component);
 
+	guard(mutex)(&wsa884x->pa_lock);
+
 	if (mute) {
+		wsa884x->pa_unmuted = false;
+		cancel_delayed_work(&wsa884x->pa_check_work);
 		snd_soc_component_write_field(component, WSA884X_DRE_CTL_1,
 					      WSA884X_DRE_CTL_1_CSR_GAIN_EN_MASK,
 					      0x0);
@@ -1824,6 +1931,11 @@
 		snd_soc_component_write_field(component, WSA884X_PA_FSM_EN,
 					      WSA884X_PA_FSM_EN_GLOBAL_PA_EN_MASK,
 					      0x1);
+		wsa884x->unmute_time = ktime_get();
+		wsa884x->pa_checks = 0;
+		wsa884x->pa_unmuted = true;
+		mod_delayed_work(system_freezable_wq, &wsa884x->pa_check_work,
+				 msecs_to_jiffies(WSA884X_PA_CHECK_FIRST_MS));
 	}
 
 	return 0;
@@ -2057,6 +2169,8 @@
 		return -ENOMEM;
 
 	mutex_init(&wsa884x->sp_lock);
+	mutex_init(&wsa884x->pa_lock);
+	INIT_DELAYED_WORK(&wsa884x->pa_check_work, wsa884x_pa_check_work);
 
 	for (i = 0; i < WSA884X_SUPPLIES_NUM; i++)
 		wsa884x->supplies[i].supply = wsa884x_supply_name[i];
@@ -2132,6 +2246,11 @@
 	pm_runtime_set_active(dev);
 	pm_runtime_enable(dev);
 
+	ret = devm_add_action_or_reset(dev, wsa884x_pa_cleanup, wsa884x);
+	if (ret)
+		return ret;
+
+
 	return devm_snd_soc_register_component(dev,
 					       &wsa884x_component_drv,
 					       wsa884x_dais,
