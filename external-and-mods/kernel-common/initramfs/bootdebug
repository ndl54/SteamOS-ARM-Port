#!/bin/sh
# Debug log collector for testers without a Linux PC. Installed into the
# root filesystem by the initramfs when the cmdline has steamos.debug=1 (the
# debug KERNEL) or a file called "debug" sits on the FAT boot partition. The
# SM8550 image also ships it as steamos-arm-bootdebug-file.service, for
# kernels that bring their own initramfs.
# Right away, then every 20 s for 3 minutes, it writes the logs to BOOT/debug-logs/, which
# any PC can read. During the next 30 minutes, perf.txt gets CPU/GPU/SD
# samples and runtime journals/audio/sleep evidence are refreshed each minute.
pocket_evo=0
tr '\0' '\n' </proc/device-tree/compatible 2>/dev/null | grep -qx 'ayaneo,pocketevo' && pocket_evo=1
out=/boot/debug-logs
# Low priority for CPU and disk, so a game running meanwhile doesn't stutter.
renice -n 19 -p $$ >/dev/null 2>&1
ionice -c 3 -p $$ >/dev/null 2>&1

# steamos.screenlog=1 (a debug boot.img for devices with no FAT partition
# and no working USB host, like the Legion Y700 Gen 4): 75 s after this
# service starts, stop the login manager so the text console gets the panel
# back, and keep a report on screen for a photo. This ends Game Mode;
# only the exact opt-in below enables it.
screen_pid=
if grep -qE '(^|[[:space:]])steamos[.]screenlog=1([[:space:]]|$)' /proc/cmdline; then
  (
    # Do not end Game Mode if there is no writable virtual console.
    [ -c /dev/tty1 ] || exit 0
    exec </dev/null >/dev/tty1 2>&1
    sleep 75
    systemctl stop display-manager.service 2>/dev/null
    sleep 3
    chvt 1 2>/dev/null
    TERM=linux setterm --blank 0 --powerdown 0 --cursor off 2>/dev/null
    while :; do
      printf '\033[2J\033[H'
      {
        echo "=== SteamOS ARM debug report, uptime $(cut -d' ' -f1 /proc/uptime)s: take a photo ==="
        echo "--- firmware copy"
        journalctl -b --no-pager -o cat -u steamos-arm-tablet-firmware.service | tail -n 14
        echo "--- GPU"
        journalctl -b -k --no-pager -o cat | grep -iE 'adreno|a8xx|a7xx|zap|gmu|msm_dpu|msm_drm|drm.*(error|fail)' | tail -n 16
        echo "--- Game Mode"
        journalctl -b --no-pager -o cat _UID=1000 | grep -iE 'gamescope|vulkan|vk_|drm|error|fail|fatal|crash' | grep -viE 'steamwebhelper|cef' | tail -n 30
        echo "--- failed units"
        systemctl --failed --no-pager --no-legend --plain 2>/dev/null | awk '{printf "%s ", $1}'; echo
        echo "--- panel"
        for c in /sys/class/drm/card*-*; do [ -e "$c/status" ] && echo "${c##*/} $(cat "$c/status") $(head -3 "$c/modes" 2>/dev/null | tr '\n' ' ')"; done
      } 2>&1 | cut -c1-118
      sleep 30
    done
  ) &
  screen_pid=$!
fi

collect_logs() {
mountpoint -q /boot || mount /boot 2>/dev/null
# Some images mount BOOT read-only (the 8 Elite ones); the logs need it
# writable, whichever unit started us.
if grep -qE '^[^ ]+ /boot [^ ]+ ro[, ]' /proc/mounts; then
  mount -o remount,rw /boot 2>/dev/null
fi
# No FAT boot partition (Lenovo Legion Y700 Gen 4 boots straight from
# boot.img): the logs go to a USB stick (FAT32/exFAT) instead, if one is
# plugged in within 2 minutes; otherwise to /boot/debug-logs on the system.
if ! mountpoint -q /boot; then
  usb=/run/steamos-arm-usblog
  usb_mounted=0
  cleanup_usb() {
    # Only release a mount created here; never touch /boot or its early
    # initramfs logger/loop device, or a mount owned by another collector.
    [ "$usb_mounted" = 1 ] || return 0
    sync
    umount "$usb" || echo "bootdebug: could not unmount $usb" >&2
  }
  trap cleanup_usb 0
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  if ! mountpoint -q "$usb" && mkdir -p "$usb"; then
    n=0
    while [ "$n" -lt 24 ]; do
      for dev in $(lsblk -rpno NAME,FSTYPE,HOTPLUG 2>/dev/null | awk '$3 == 1 && ($2 == "vfat" || $2 == "exfat") { print $1 }'); do
        # HOTPLUG also includes non-USB media. Internal UFS is sd* too:
        # use the USB ancestry check from the initramfs image selector.
        case "$(readlink -f "/sys/class/block/${dev##*/}")" in
          */usb*) ;;
          *) continue ;;
        esac
        if mount -o rw "$dev" "$usb" 2>/dev/null; then
          usb_mounted=1
          out="$usb/debug-logs"
          echo "bootdebug: logs to the USB stick $dev"
          break 2
        fi
      done
      n=$((n + 1)); sleep 5
    done
  fi
fi
mkdir -p "$out" || { echo "bootdebug: $out isn't writable, no logs" >&2; exit 0; }
if [ "$pocket_evo" = 1 ]; then
{
  date
  uname -a
  cat /etc/os-release
} > "$out/release.txt" 2>&1
{
  for f in /sys/fs/pstore/*; do
    [ -f "$f" ] || continue
    echo "--- ${f##*/}"
    head -c 1048576 "$f"
  done
} > "$out/pstore.txt" 2>&1
fi

runtime_evidence() {
  [ "$pocket_evo" = 1 ] || return 0
  journalctl -b --no-pager -o short-monotonic > "$out/journal.txt" 2>&1
  journalctl -b --no-pager -o short-monotonic _UID=1000 > "$out/journal-user.txt" 2>&1
  dmesg > "$out/dmesg.txt" 2>&1
  {
    echo "--- uptime $(cat /proc/uptime)"
    cat /proc/asound/cards /proc/asound/pcm
    for card in /proc/asound/card[0-9]*; do
      [ -d "$card" ] || continue
      echo "--- ${card##*/} mixers"
      timeout 5 amixer -c "${card##*card}" contents
    done
    echo "--- PipeWire cards and sinks"
    timeout 5 runuser -u steamos -- env XDG_RUNTIME_DIR=/run/user/1000 pactl list cards
    timeout 5 runuser -u steamos -- env XDG_RUNTIME_DIR=/run/user/1000 pactl list sinks
    echo "--- UCM setup result"
    cat /tmp/sm8550-alsaucm.log
  } > "$out/audio.txt" 2>&1
  {
    echo "--- uptime $(cat /proc/uptime)"
    cat /sys/power/state /sys/power/mem_sleep /sys/power/pm_wakeup_irq
    for f in /sys/power/suspend_stats/*; do
      [ -f "$f" ] || continue
      echo "--- ${f##*/}"; cat "$f"
    done
    echo "--- sleep mode"
    timeout 2 /usr/lib/konkr/sleep-mode
  } > "$out/sleep.txt" 2>&1
}
# The boot before this one: after a freeze and a forced restart, that's the
# one with the answer (the journal is persistent).
journalctl -b -1 --no-pager -o short-monotonic > "$out/journal-previous-boot.txt" 2>&1
# GPU/GMU hang dumps kept by save-devcoredump (they're gone from the kernel
# after five minutes).
[ -d /var/lib/steamos-arm/devcoredump ] && cp -a /var/lib/steamos-arm/devcoredump "$out/" 2>/dev/null
i=0
# First pass straight away (a hang shortly after boot still leaves logs),
# then every 20 s.
while [ "$i" -lt 10 ]; do
  [ "$i" -gt 0 ] && sleep 20
  i=$((i + 1))
  {
    echo "=== pass $i  uptime $(cat /proc/uptime)"
    cat /sys/firmware/devicetree/base/model 2>/dev/null | tr -d '\0'; echo
    uname -a
    echo "--- failed units"; systemctl --failed --no-pager
    echo "--- sessions"; loginctl list-sessions --no-pager
    echo "--- drm"; for c in /sys/class/drm/card*-*; do echo "$c $(cat $c/status 2>/dev/null) $(head -1 $c/modes 2>/dev/null)"; done
    echo "--- backlight"; for b in /sys/class/backlight/*; do echo "$b $(cat $b/brightness)/$(cat $b/max_brightness)"; done
    echo "--- gpu"; ls /sys/class/devfreq/ 2>&1; dmesg | grep -i -E "adreno|msm_dpu|a7xx|gmu|zap|drm" | tail -40
  } > "$out/summary.txt" 2>&1
  dmesg > "$out/dmesg.txt" 2>&1
  {
    echo "--- pci (vendor:device class -> driver)"
    for p in /sys/bus/pci/devices/*; do
      [ -e "$p" ] || continue
      d=$(readlink "$p/driver" 2>/dev/null); d=${d##*/}
      echo "${p##*/} $(cat "$p/vendor" "$p/device" "$p/class" 2>/dev/null | tr '\n' ' ')-> ${d:-none}"
    done
    echo "--- usb"; for u in /sys/bus/usb/devices/*; do [ -e "$u/idVendor" ] && echo "${u##*/} $(cat "$u/idVendor"):$(cat "$u/idProduct") $(cat "$u/product" 2>/dev/null)"; done
    echo "--- input"; cat /proc/bus/input/devices
    echo "--- network"; ip -br link 2>&1; nmcli -t device 2>&1
    echo "--- modules"; cat /proc/modules
  } > "$out/devices.txt" 2>&1
  journalctl -b --no-pager -o short-monotonic > "$out/journal.txt" 2>&1
  journalctl -b --no-pager -o short-monotonic _UID=1000 > "$out/journal-user.txt" 2>&1
  journalctl -b --no-pager -o short-monotonic -t gamescope-session -t gamescope -t bottom-screen > "$out/gamescope.txt" 2>&1
  # vulkaninfo loads the whole driver: on the second pass (the session is up
  # by then) and the last, not every 20 s.
  if [ "$i" -eq 2 ] || [ "$i" -eq 10 ]; then
    runuser -u steamos -- env XDG_RUNTIME_DIR=/run/user/1000 vulkaninfo --summary > "$out/vulkan.txt" 2>&1
    runtime_evidence
  fi
  sync
done
if [ "$pocket_evo" = 1 ]; then
  echo "boot snapshots done; runtime capture continues, $(date)" > "$out/DONE.txt"
else
  echo "done, $(date)" > "$out/DONE.txt"
fi
sync

# Then 30 minutes of performance samples every 5 s, so a tester can just play
# a game and send the folder: CPU clocks per cluster, GPU clock/governor, the
# hottest sensor and the SD card's bus mode.
mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug 2>/dev/null
gpu=$(ls -d /sys/class/devfreq/*gpu* /sys/class/devfreq/3d00000.gpu 2>/dev/null | head -1)
{
  echo "--- cpufreq"
  for p in /sys/devices/system/cpu/cpufreq/policy*; do
    echo "${p##*/} cpus=$(cat $p/related_cpus) gov=$(cat $p/scaling_governor) max=$(cat $p/scaling_max_freq)/$(cat $p/cpuinfo_max_freq)"
  done
  echo "--- gpu ${gpu:-none}"
  [ -n "$gpu" ] && echo "gov=$(cat $gpu/governor) min=$(cat $gpu/min_freq) max=$(cat $gpu/max_freq) avail=$(cat $gpu/available_frequencies)"
  echo "--- sd"; cat /sys/kernel/debug/mmc0/ios 2>&1
  echo "--- samples: uptime | cpu MHz per policy | gpu MHz (load) | max temp C"
} > "$out/perf.txt" 2>&1
n=0
while [ "$n" -lt 360 ]; do
  c=""; for p in /sys/devices/system/cpu/cpufreq/policy*; do c="$c $(( $(cat $p/scaling_cur_freq) / 1000 ))"; done
  g="-"; [ -n "$gpu" ] && g="$(( $(cat $gpu/cur_freq) / 1000000 )) ($(cat $gpu/load 2>/dev/null || echo ?))"
  t=$(cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | sort -n | tail -1)
  echo "$(cut -d' ' -f1 /proc/uptime) |$c | $g | $(( ${t:-0} / 1000 ))" >> "$out/perf.txt"
  n=$((n + 1))
  if [ $((n % 12)) -eq 0 ]; then
    runtime_evidence
    sync
  fi
  sleep 5
done
runtime_evidence
[ "$pocket_evo" != 1 ] || echo "all capture done, $(date)" > "$out/DONE.txt"
sync
}

if [ -n "$screen_pid" ]; then
  # Keep the service's main process alive even if the file destination fails.
  # The collector's exit/USB cleanup traps must finish before waiting for the
  # screen worker, which deliberately runs until the service is stopped.
  ( collect_logs )
  wait "$screen_pid"
else
  collect_logs
fi
